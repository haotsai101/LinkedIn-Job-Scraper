# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.
#
# First-time setup:
#   playwright install chromium

# ── LLM roles ─────────────────────────────────────────────────────────────────
# Read by config.py (get_llm_config). One role remains:

# guided_apply — job relevance classification AND the LinkedIn Easy Apply
# browser agent (EasyApplyFlow), both via the Claude Agent SDK. (T14b, T38)
# Uses subscription auth: no API key, no base URL — you must be logged in with
# the `claude` CLI on this machine. Default model: claude-sonnet-5
# (the relevance classifier route overrides this with claude-haiku-4-5).
GUIDED_APPLY_MODEL=claude-sonnet-5

# (OffsiteApply automation — the opt-in NVIDIA NIM classifier route and the
# `browser_use` LLM role that used to drive OffsiteApplyFlow's offsite form
# filling — was removed in full and is pending a from-scratch redesign. The
# CLASSIFIER_ROUTE / CLASSIFIER_* / BROWSER_USE_* / BROWSER_LLM_* env vars
# that used to configure it are gone too; a new engine will need its own.)

# ── Legacy names — OPTIONAL (T14b) ───────────────────────────────────────────
# Nothing in the apply agent proper requires LLM_API / LLM_URL any more — the
# classifier and the browser agent both use the Claude Agent SDK (subscription
# auth). The only remaining reader is the legacy OpenAI-backed profile-setup
# interview (`apply_jobs.py --setup`), which degrades to raw answers when
# these are unset.
# LLM_API=your-api-key-here
# LLM_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.2-11b-vision-instruct

# ── Notifications ────────────────────────────────────────────────────────────
# Gmail notification (optional — skipped if not set).
# App Password: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Apply agent ─────────────────────────────────────────────────────────────
# Max applications per autonomous session (default: 10)
MAX_AUTO_APPLY=10
