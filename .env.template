# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.
#
# First-time setup:
#   playwright install chromium

# ── LLM roles ─────────────────────────────────────────────────────────────────
# Three independent roles, each with its own model (and, for the two
# OpenAI-compatible roles, its own API key + base URL). Swap any of these with a
# single edit here. Read by config.py (get_llm_config).

# classifier — job relevance scoring (OffsiteApply route; EasyApply uses the Agent SDK).
# Default: meta/llama-3.2-11b-vision-instruct @ https://integrate.api.nvidia.com/v1
# (validated 2026-09-02, T27; google/gemma-4-31b-it was timing out on the free
# NIM tier; meta/llama-3.1-8b-instruct was EOL'd on NIM 2026-08-26.)
CLASSIFIER_MODEL=meta/llama-3.2-11b-vision-instruct
CLASSIFIER_API=your-api-key-here
CLASSIFIER_BASE_URL=https://integrate.api.nvidia.com/v1

# browser_use — form-filling / DOM reasoning during offsite apply.
# Default: deepseek-ai/deepseek-v4-flash-0731 @ https://integrate.api.nvidia.com/v1
BROWSER_USE_MODEL=deepseek-ai/deepseek-v4-flash-0731
BROWSER_USE_API=your-api-key-here
BROWSER_USE_BASE_URL=https://integrate.api.nvidia.com/v1

# guided_apply — LinkedIn Easy Apply relevance classification AND the offsite
# form-filling browser agent (OffsiteApplyFlow / EasyApplyFlow /
# ScriptApplyEngine), all via the Claude Agent SDK. (T14b)
# Uses subscription auth: no API key, no base URL — you must be logged in with
# the `claude` CLI on this machine. Default model: claude-sonnet-5
# (the Easy Apply classifier route overrides this with claude-haiku-4-5).
GUIDED_APPLY_MODEL=claude-sonnet-5

# ── Legacy names — OPTIONAL (T14b) ───────────────────────────────────────────
# As of T14b nothing requires LLM_API / LLM_URL: the classifier uses CLASSIFIER_*
# (NIM) or the Claude Agent SDK, and the browser agent uses the Agent SDK
# (subscription auth). The only remaining reader is the legacy OpenAI-backed
# profile-setup interview (`apply_jobs.py --setup`), which degrades to raw
# answers when these are unset. config.py still accepts them as
# DeprecationWarning-ing fallback aliases for the canonical vars above for one
# more release.
# LLM_API=your-api-key-here
# LLM_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.2-11b-vision-instruct

# Other deprecated aliases config.py accepts as fallback (canonical name shown):
#   CLASSIFIER_LLM_API / _URL / _MODEL   -> CLASSIFIER_API / _BASE_URL / _MODEL
#   BROWSER_LLM_API / _URL / _MODEL      -> BROWSER_USE_API / _BASE_URL / _MODEL
#   BROWSER_LLM_FALLBACK_MODEL           -> (no replacement; circuit-breaker
#                                            fallback handled elsewhere)

# ── Notifications ────────────────────────────────────────────────────────────
# Gmail notification (optional — skipped if not set).
# App Password: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Apply agent ─────────────────────────────────────────────────────────────
# Max applications per autonomous session (default: 10)
MAX_AUTO_APPLY=10
