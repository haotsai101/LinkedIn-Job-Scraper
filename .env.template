# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.
#
# First-time setup:
#   playwright install chromium

# ── LLM roles ─────────────────────────────────────────────────────────────────
# Three independent roles, each with its own model (and, for the two
# OpenAI-compatible roles, its own API key + base URL). Swap any of these with a
# single edit here. Read by config.py (get_llm_config).

# classifier — job relevance scoring. Small / fast models work great.
# Default: meta/llama-3.1-8b-instruct @ https://integrate.api.nvidia.com/v1
CLASSIFIER_MODEL=meta/llama-3.1-8b-instruct
CLASSIFIER_API=your-api-key-here
CLASSIFIER_BASE_URL=https://integrate.api.nvidia.com/v1

# browser_use — form-filling / DOM reasoning during offsite apply.
# Default: deepseek-ai/deepseek-v4-flash-0731 @ https://integrate.api.nvidia.com/v1
BROWSER_USE_MODEL=deepseek-ai/deepseek-v4-flash-0731
BROWSER_USE_API=your-api-key-here
BROWSER_USE_BASE_URL=https://integrate.api.nvidia.com/v1

# guided_apply — LinkedIn Easy Apply via the Claude Agent SDK.
# Uses subscription auth: no API key, no base URL. Default: claude-sonnet-5
GUIDED_APPLY_MODEL=claude-sonnet-5

# ── Legacy names — STILL REQUIRED until the T14 release ───────────────────────
# apply_jobs.py:load_env still reads these directly and hard-exits without
# LLM_API / LLM_URL. Keep them filled in. Once T14 wires config.py into the
# apply agent these become optional fallback aliases (used with a
# DeprecationWarning if a canonical var above is unset) and will be removed the
# release after that.
LLM_API=your-api-key-here
LLM_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-8b-instruct

# Other deprecated aliases config.py accepts as fallback (canonical name shown):
#   CLASSIFIER_LLM_API / _URL / _MODEL   -> CLASSIFIER_API / _BASE_URL / _MODEL
#   BROWSER_LLM_API / _URL / _MODEL      -> BROWSER_USE_API / _BASE_URL / _MODEL
#   BROWSER_LLM_FALLBACK_MODEL           -> (no replacement; circuit-breaker
#                                            fallback handled elsewhere)

# ── Notifications ────────────────────────────────────────────────────────────
# Gmail notification (optional — skipped if not set).
# App Password: Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ── Apply agent ─────────────────────────────────────────────────────────────
# Max applications per autonomous session (default: 10)
MAX_AUTO_APPLY=10
